<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.dsa.modernlibrarysystem.ResetPasswordController" alignment="CENTER">
    <HBox alignment="CENTER" spacing="150">
        <ImageView >
            <image>
                <Image url="@../Assets/Icons/LoginBanner.png" preserveRatio="false"/>
            </image>
        </ImageView>
        <VBox fx:id="registerVBox" spacing="10">
            <Label text="Reset Password" style="-fx-text-fill:DodgerBlue;-fx-font-size:16pt;"/>
            <TitledPane text="Reset Password" collapsible="false">
                <VBox spacing="10">
                    <HBox spacing="5">
                        <Label style="-fx-text-fill:#B3B3B3;" text="Code: "/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="otpField" promptText="enter security code" />
                    </HBox>
                    <HBox spacing="5">
                        <Label style="-fx-text-fill:#B3B3B3;" text="New Password: "/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <PasswordField fx:id="passwordField" promptText="enter new password"/>
                    </HBox>
                    <HBox spacing="5">
                        <Label style="-fx-text-fill:#B3B3B3;" text="Confirm Password: "/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="confirm password"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Reset" onAction="#resetPassword">
                            <graphic>
                                <ImageView>
                                    <image>
                                        <Image url="@../Assets/Icons/reset_ico.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="resendBt" text="Resend" onAction="#resendCode" disable="true">
                            <graphic>
                                <ImageView>
                                    <image>
                                        <Image url="@../Assets/Icons/resend_ico.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button text="Back To Login" onAction="#returnToLogin">
                            <graphic>
                                <ImageView>
                                    <image>
                                        <Image url="@../Assets/Icons/back_ico.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </TitledPane>

            <TitledPane text="Password Requirement" collapsible="false">
                <VBox>
                    <Label text="Minimum 6 characters"/>
                    <Label text="Use a strong,unique password"/>
                </VBox>
            </TitledPane>
        </VBox>
    </HBox>
</VBox>

