<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.dsa.modernlibrarysystem.DashIssueReturnView" spacing="15" alignment="TOP_CENTER">
    <Label styleClass="headerText" text="Issue/Return Books"/>
    <TabPane>
        <tabs>
            <Tab text="Issue Book" closable="false">
                <TitledPane text="Issue Book To Member" collapsible="false">
                    <HBox alignment="CENTER">
                        <padding>
                            <Insets top="50" bottom="30" left="30" right="30"/>
                        </padding>
                        <VBox spacing="10" alignment="TOP_CENTER">
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <Label text="Select Book:"/>
                                <Region minWidth="27"/>
                                <ComboBox fx:id="bookCombobox" editable="true" minWidth="350"/>
                            </HBox>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <Label text="Select Member:"/>
                                <Region minWidth="5"/>
                                <ComboBox fx:id="memberCombobox" editable="true" minWidth="350"/>
                            </HBox>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <Label text="Due Days:"/>
                                <Region minWidth="38"/>
                                <TextField fx:id="dueDateField" promptText="Enter due days"/>
                            </HBox>
                            <Button text="Issue Book" onAction="#issueBook"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ImageView>
                            <image>
                                <Image url="@../Assets/Icons/big_book_ico.png"/>
                            </image>
                        </ImageView>
                    </HBox>

                </TitledPane>
            </Tab>
            <Tab text="Return Book" closable="false">
                <TitledPane text="Return Issued Book" collapsible="false">
                    <VBox spacing="5" alignment="TOP_CENTER">
                        <HBox spacing="25" alignment="CENTER">
                            <Label text="Search:"/>
                            <TextField fx:id="searchField" promptText="Search Issued books"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Refresh" onAction="#refreshReturnedBooks"/>
                        </HBox>
                        <TreeTableView fx:id="returnTableView">
                            <columns>
                                <TreeTableColumn fx:id="rIssueIdCol" text="Issue ID" reorderable="false" resizable="false" sortable="false"/>
                                <TreeTableColumn fx:id="rIssueTitleCol" text="Book Title" prefWidth="350" reorderable="false" resizable="false" sortable="false"/>
                                <TreeTableColumn fx:id="rIssueMemberCol" text="Member Name" prefWidth="350" reorderable="false" resizable="false" sortable="false"/>
                                <TreeTableColumn fx:id="rIssueIssueDateCol" text="Issue Date" prefWidth="185" reorderable="false" resizable="false" sortable="false"/>
                                <TreeTableColumn fx:id="rIssueDueDateCol" text="Due Date" prefWidth="185" reorderable="false" resizable="false" sortable="false"/>
                                <TreeTableColumn fx:id="rIssueStatusCol" text="Status" prefWidth="186" reorderable="false" resizable="false" sortable="false"/>
                            </columns>
                        </TreeTableView>
                        <Button text="Return Selected Book" onAction="#returnBook"/>
                    </VBox>
                </TitledPane>
            </Tab>
            <Tab text="Currently Issued" closable="false">
                <VBox spacing="5">
                    <HBox alignment="CENTER" spacing="25">
                        <Label text="Currently Issued Books"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="overDueRemBt" text="Send Overdue Reminders" onAction="#sendOverDueReminders"/>
                        <Button text="Refresh" onAction="#refreshIssuedBooks"/>
                    </HBox>
                    <TreeTableView fx:id="issueTableView">
                        <columns>
                            <TreeTableColumn fx:id="issueIdCol" text="Issue ID" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueTitleCol" text="Book Title" prefWidth="230" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueAuthorCol" text="Author" prefWidth="200" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueMemberCol" text="Member Name" prefWidth="220" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueIssuedCol" text="Issued By" prefWidth="210" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueIssueDateCol" text="Issue Date" prefWidth="105" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueDueDateCol" text="Due Date" prefWidth="105" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueReturnDateCol" text="Return Date" prefWidth="100" reorderable="false" resizable="false" sortable="false"/>
                            <TreeTableColumn fx:id="issueStatusCol" text="Status" prefWidth="107" reorderable="false" resizable="false" sortable="false"/>
                        </columns>
                    </TreeTableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
