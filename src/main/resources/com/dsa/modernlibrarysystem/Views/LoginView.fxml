<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.dsa.modernlibrarysystem.LoginController" alignment="CENTER">
    <HBox alignment="CENTER" spacing="150">
        <ImageView >
            <image>
                <Image url="@../Assets/Icons/LoginBanner.png" preserveRatio="false"/>
            </image>
        </ImageView>
        <VBox spacing="10" alignment="TOP_CENTER">
            <ImageView>
                <image>
                    <Image url="@../Assets/Icons/mitm_logo_trans.png" requestedWidth="170" requestedHeight="180"/>
                </image>
            </ImageView>
            <Label text="Modern Library System" alignment="CENTER" fx:id="welcomeText"/>
            <Label style="-fx-text-fill:#B3B3B3;" alignment="CENTER" text="Please login to continue"/>
            <TitledPane text="Login" collapsible="false">
                <VBox spacing="10">
                    <HBox spacing="5" alignment="CENTER">
                        <Label style="-fx-text-fill:#B3B3B3;" text="Username: "/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="userField" promptText="enter username"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER">
                        <Label style="-fx-text-fill:#B3B3B3;" text="Password: "/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <PasswordField fx:id="passwordField" promptText="enter password"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Login" onAction="#loginToSystem">
                            <graphic>
                                <ImageView>
                                    <image>
                                        <Image url="@../Assets/Icons/login_ico.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button text="Register Admin" onAction="#goToRegisterBox">
                            <graphic>
                                <ImageView>
                                    <image>
                                        <Image url="@../Assets/Icons/register_ico.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="forgotPassBt" text="Forgot Password?" onAction="#sendPassToMail">
                            <graphic>
                                <ImageView>
                                    <image>
                                        <Image url="@../Assets/Icons/forgot_icon.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </TitledPane>
            <Region VBox.vgrow="ALWAYS"  prefHeight="165"/>
        </VBox>
    </HBox>
</VBox>
