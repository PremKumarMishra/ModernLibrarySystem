<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.dsa.modernlibrarysystem.MainController" stylesheets="@../Stylesheets/root.css">
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="5">
        <padding>
            <Insets left="4"/>
        </padding>
        <ImageView>
           <image>
               <Image url="@../Assets/Icons/mitm_logo_trans.png" requestedWidth="25" requestedHeight="25"/>
           </image>
        </ImageView>
        <Label fx:id="title" text="Modern Library System"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="minimizeBt" prefWidth="15" prefHeight="15"  minWidth="15" minHeight="15" onAction="#minimizeWindow"/>
        <Button fx:id="closeBt" prefWidth="15" prefHeight="15"  minWidth="15" minHeight="15" onAction="#closeWindow"/>
    </HBox>
    <VBox spacing="20.0"  fx:id="bodyArea">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
    </VBox>
</VBox>
